# Configuration de la base de données
# Définir l'URL de connexion à MySQL (createDatabaseIfNotExist=true crée automatiquement la BDD)
DB_URL=jdbc:mysql://localhost:3306/mdd_db?createDatabaseIfNotExist=true

# Nom d'utilisateur MySQL
DB_USERNAME=votre_user_mysql

# Mot de passe MySQL
DB_PASSWORD=votre_mot_de_passe_mysql

# Durée de validité de l'access token JWT en secondes (900 secondes = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION=900

# Durée de validité du refresh token JWT en secondes (604800 secondes = 7 jours)
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Clé secrète JWT en Base64 (générer avec: openssl rand -base64 64)
JWT_SECRET=VotreCleSecreteBase64EncorePlusLonguePourLaSecurite

